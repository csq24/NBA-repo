# Copy to .env.local and fill in values. Restart `npm run dev` after changes.

# --- Supabase (Project Settings → API) ---
# Use your project URL and anon (publishable) key — restart dev after edits.
NEXT_PUBLIC_SUPABASE_URL=https://lsyfoevelbwbxrndrgpv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: same values without NEXT_PUBLIC_ (Supabase CLI / some plugins); next.config bridges these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only: used by comment posting, Clerk webhook, and GET /api/sync-boxscore (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protects /api/sync-boxscore in production (Bearer token). Omitted in dev → sync route allows unauthenticated GET.
CRON_SECRET=
# Optional: Postgres URI from Dashboard → Database → Connection string (for `npm run db:apply-users` only).
DATABASE_URL=

# --- Clerk (Dashboard → API Keys) — optional for scoreboard-only; required for sign-in and comments ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: publishable key without NEXT_PUBLIC_ (some tools); next.config bridges to NEXT_PUBLIC_*.
CLERK_PUBLISHABLE_KEY=
# Webhook signing secret (Dashboard → Webhooks → your endpoint)
CLERK_WEBHOOK_SECRET=

# --- ESPN Site API base (optional). Must include /apis/site/v2/sports if you override. ---
NEXT_PUBLIC_ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports
